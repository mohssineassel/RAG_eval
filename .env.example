OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# LLM for the agent and the judge: openai | groq | gemini | ollama
PROVIDER="groq"
GROQ_MODEL="openai/gpt-oss-120b"
# Optional: a different model for the judge, so it has its own Groq daily token limit
# (the judge uses most of the tokens). Defaults to GROQ_MODEL.
GROQ_JUDGE_MODEL="qwen/qwen3.8-27b"
GEMINI_MODEL="gemini-flash-latest"

# Embeddings for the vector store: openai | gemini | ollama
EMBEDDING_PROVIDER="gemini"
